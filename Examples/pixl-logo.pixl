# PIXL logo convertido desde SVG.
# El brillo SVG se representa con contornos y colores RGBA equivalentes.
PIXL(1.1)
CANVAS(64, 64)
TIPE(bit)
HEX8()

LAYER(1)
    rect(1-64, 1-64, 0D1117FF)

    # Cuadricula sutil superior e inferior
    rect(8-9, 8-9, 161B2266)
    rect(16-17, 8-9, 161B2266)
    rect(24-25, 8-9, 161B2266)
    rect(32-33, 8-9, 161B2266)
    rect(40-41, 8-9, 161B2266)
    rect(48-49, 8-9, 161B2266)
    rect(56-57, 8-9, 161B2266)
    rect(8-9, 54-55, 161B2266)
    rect(16-17, 54-55, 161B2266)
    rect(24-25, 54-55, 161B2266)
    rect(32-33, 54-55, 161B2266)
    rect(40-41, 54-55, 161B2266)
    rect(48-49, 54-55, 161B2266)
    rect(56-57, 54-55, 161B2266)

    # Matriz de pixeles
    rect(12-15, 16-19, 005F73FF)
    rect(12-15, 24-27, 005F73FF)
    rect(12-15, 32-35, 005F73FF)
    rect(12-15, 40-43, 005F73FF)
    rect(12-15, 44-47, 005F73FF)
    rect(16-19, 44-47, 005F73FF)
    rect(20-23, 44-47, 005F73FF)

    rect(16-19, 16-19, 0A9396FF)
    rect(12-15, 20-23, 0A9396FF)
    rect(16-19, 24-27, 0A9396FF)
    rect(20-23, 24-27, 0A9396FF)
    rect(16-19, 32-35, 0A9396FF)
    rect(20-23, 32-35, 0A9396FF)
    rect(16-19, 40-43, 0A9396FF)
    rect(20-23, 40-43, 0A9396FF)
    rect(24-27, 44-47, 0A9396FF)

    rect(20-23, 16-19, 94D2BDFF)
    rect(24-27, 16-19, 94D2BDFF)
    rect(16-19, 20-23, 94D2BDFF)
    rect(20-23, 20-23, 94D2BDFF)
    rect(24-27, 24-27, 94D2BDFF)
    rect(24-27, 32-35, 94D2BDFF)
    rect(28-31, 36-39, 94D2BDFF)
    rect(24-27, 40-43, 94D2BDFF)
    rect(28-31, 44-47, 94D2BDFF)

    # Zona de transicion
    rect(28-31, 16-19, E9D8A6FF)
    rect(28-31, 20-23, E9D8A6FF)
    rect(32-35, 24-27, E9D8A6FF)
    rect(32-35, 28-31, E9D8A6FF)
    rect(32-35, 36-39, E9D8A6FF)

    # Forma vectorial y acento interior
    polygon(36,16, 52,16, 44,32, 52,48, 36,48, 28,32, EE9B00F2, fill)
    polygon(38,20, 48,20, 42,32, 48,44, 38,44, 32,32, CA6702FF, fill)
    circle(42,32,3, E9D8A6FF, fill)

    # Contorno de alineacion y nodos de control
    polygon(36,16, 52,16, 44,32, 52,48, 36,48, 28,32, 00F5D4CC, outline, 1, c)
    rect(35-37, 15-17, FFFFFFFF)
    rect(51-53, 15-17, FFFFFFFF)
    rect(43-45, 31-33, FFFFFFFF)
    rect(51-53, 47-49, FFFFFFFF)
    rect(35-37, 47-49, FFFFFFFF)
    rect(27-29, 31-33, FFFFFFFF)
